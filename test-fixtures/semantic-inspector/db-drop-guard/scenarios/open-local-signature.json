{
  "name": "open-local-signature",
  "actions": [
    {
      "id": "bootstrap",
      "requests": [
        "/api/v1/revision",
        "/api/v1/session",
        "/api/v1/symbols"
      ]
    },
    {
      "id": "select-local-db",
      "route": "/symbols/local%2Fdb-drop-guard%2Fimpl-DbDropGuard%2Fdb/signature",
      "requests": [
        "/api/v1/symbol?path=local%2Fdb-drop-guard%2Fimpl-DbDropGuard%2Fdb",
        "/api/v1/product?symbol=local%2Fdb-drop-guard%2Fimpl-DbDropGuard%2Fdb&product=signature",
        "/api/v1/runs/run_2"
      ]
    }
  ]
}
