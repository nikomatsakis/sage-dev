        "            } else {",
        "                diagnostics.push(Diagnostic {",
        "                    file: context.file.to_owned(),",
        "                    span: comment.span.clone(),",
        "                    message: \"implementation region closer has no opening marker\".into(),",
        "                });",
        "            }",
        "            continue;",
        "        }",
        "        if !text.starts_with(\"{anchor}\") {",
