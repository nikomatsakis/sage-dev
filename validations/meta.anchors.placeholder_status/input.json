        "            span: self.lines.span(self.source, item.span()),",
        "            module: self.module.clone(),",
        "            cfg: self.cfg.clone(),",
        "        });",
        "        syn::visit::visit_trait_item_fn(self, item);",
        "        self.cfg.truncate(previous_cfg);",
        "    }",
