        "#[test]",
        "#[sage::test(meta.language.fields.kinds)]",
        "fn fields_preserve_identity_input_and_state_kinds() {",
        "    let document = valid(",
        "        r#\"class Item { \"\"\"Identity and input.\"\"\" identity key: u32; input value: u32; }",
        "        context Work { \"\"\"Local state.\"\"\" state pending: u32; }\"#,",
        "    );",
