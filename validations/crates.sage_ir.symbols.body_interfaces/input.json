        "                        receiver_eligibility = SolverEligibility::Unsupported;",
        "                    } else {",
        "                        receiver = Some(CheckedReceiver {",
        "                            owner_self_ty: owner.self_ty.unwrap(),",
        "                            form: MethodReceiver::Ref { mutability },",
