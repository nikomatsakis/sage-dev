        ") -> OpenedOwner<'db> {",
        "    use crate::generic_param::GenericParamKind;",
        "    use crate::symbol::TraitSymbol;",
        "    use crate::ty::{SolverEligibility, TraitRef, Ty, WherePredicate};",
        "",
