        "",
        "fn claim_path(workspace: &Path, file: &str) -> Result<String, Box<dyn Error>> {",
        "    let docs = if workspace.join(\"book.toml\").is_file() {",
        "        crate::workspace::book_source_root(workspace)?",
        "    } else {",
        "        workspace.join(\"md\")",
        "    };",
        "    Ok(docs",
        "        .join(file)",
        "        .strip_prefix(workspace)?",
        "        .to_string_lossy()",
        "        .replace('\\\\', \"/\"))",
        "}",
