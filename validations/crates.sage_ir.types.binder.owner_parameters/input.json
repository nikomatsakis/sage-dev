        "struct OpenedOwner<'db> {",
        "    generics: Vec<crate::generic_param::GenericParam<'db>>,",
        "    self_ty: Option<Ptr<crate::ty::Ty<'db>>>,",
        "    where_clauses: Vec<crate::ty::WherePredicate<'db>>,",
        "    eligibility: crate::ty::SolverEligibility,",
