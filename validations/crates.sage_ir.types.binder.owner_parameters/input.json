        "                        error",
        "                    };",
        "                    cx.catch(error);",
        "                    expr",
        "                }",
        "            }",
        "        });",
        "",
        "        // Resolve remaining inference variables.",
        "        cx.finalize();",
        "",
        "        cx.finish(body_expr, cst.span)",
        "    }",
        "    // ANCHOR_END: example_fn_body",
