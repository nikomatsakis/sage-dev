        "    // {anchor}`crates.sage_ir.symbols.body_interfaces`",
        "    pub fn body(self, db: &'db dyn crate::Db) -> CheckedBody<'db> {",
        "        use crate::check::infer_ctx::{ErrorContext, InferCtx, Scope};",
        "        use crate::local_syms::LocalModItemSym;",
