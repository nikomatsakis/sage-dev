        "        Ty::Alias(AliasTy::Associated(projection))",
        "            if projection_matches(cx, projection, symbols, left_ty, right_ty) =>",
        "        {",
        "            Some(projection)",
        "        }",
        "        Ty::Bool => None,",
        "        Ty::Alias(_)",
        "        | Ty::Char",
        "        | Ty::Int(_)",
        "        | Ty::Uint(_)",
        "        | Ty::Float(_)",
        "        | Ty::Str",
        "        | Ty::Adt(_, _)",
        "        | Ty::Ref(_, _, _)",
        "        | Ty::Tuple(_)",
        "        | Ty::Slice(_)",
        "        | Ty::Array(_, _)",
        "        | Ty::FnPtr(_, _)",
        "        | Ty::Param(_)",
        "        | Ty::InferVar(_)",
        "        | Ty::Never",
        "        | Ty::Error(_) => {",
        "            return diagnosed_error(cx, span, \"the operator result signature is unsupported\");",
        "        }",
