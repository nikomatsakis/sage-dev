        "pub fn inventory(",
        "    spec: &SpecIndex,",
        "    rust: &CorrespondenceIndex,",
        ") -> Result<BTreeMap<String, ReviewInput>, Box<dyn Error>> {",
        "    let workspace = rust.workspace_root().unwrap_or(Path::new(\".\"));",
        "    let mut test_identities = BTreeMap::new();",
