        "            crate_name: context.crate_name.to_owned(),",
        "            target: context.target.to_owned(),",
        "            module: scope.module.clone(),",
        "            cfg: scope.cfg.clone(),",
        "            status,",
        "            explanation: None,",
        "            line,",
        "            end_line,",
