        "            \"provider\": provider,",
        "            \"revision_id\": current_revision,",
        "            \"status\": status,",
        "            \"run_id\": run_id,",
        "            \"duration_ms\": started.elapsed().as_millis(),",
        "        })",
        "    );",
        "    let _ = reply.sender.send(response);",
        "}",
        "",
        "fn actor_unavailable() -> ErrorResponse {",
