        "        revision_id: \"rev_unknown\".to_owned(),",
        "        request_id: \"request-unavailable\".to_owned(),",
        "        run_id: None,",
        "        error: ApiError::new(\"actor-unavailable\", \"the inspection database actor stopped\"),",
        "    }",
        "}",
